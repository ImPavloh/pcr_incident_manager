<odoo>
    <data>
        <!-- vista form -->
        <record id="pcr_ai_service_form" model="ir.ui.view">
            <field name="name">pcr.ai.service.form</field>
            <field name="model">pcr_incident_manager.ai.service</field>
            <field name="arch" type="xml">
                <form string="Servicio IA">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="active"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- vista tree -->
        <record id="pcr_ai_service_tree" model="ir.ui.view">
            <field name="name">pcr.ai.service.tree</field>
            <field name="model">pcr_incident_manager.ai.service</field>
            <field name="arch" type="xml">
                <tree string="Servicios IA">
                    <field name="name"/>
                    <field name="active"/>
                </tree>
            </field>
        </record>

        <!-- acción -->
        <record id="pcr_ai_service_action" model="ir.actions.act_window">
            <field name="name">Servicio IA</field>
            <field name="res_model">pcr_incident_manager.ai.service</field>
            <field name="view_mode">tree,form</field>
        </record>
    </data>
</odoo>
