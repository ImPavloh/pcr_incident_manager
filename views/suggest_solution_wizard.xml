<odoo>
    <data>
        <!-- vista tree -->
        <record id="pcr_suggest_solution_wizard_tree" model="ir.ui.view">
            <field name="name">pcr.suggest.solution.wizard.tree</field>
            <field name="model">pcr_incident_manager.suggest.solution.wizard</field>
            <field name="arch" type="xml">
                <tree string="Sugerencias de solución">
                    <field name="incident_id"/>
                    <field name="create_date" string="Fecha"/>
                </tree>
            </field>
        </record>

        <!-- vista form -->
        <record id="pcr_suggest_solution_wizard_form" model="ir.ui.view">
            <field name="name">pcr.suggest.solution.wizard.form</field>
            <field name="model">pcr_incident_manager.suggest.solution.wizard</field>
            <field name="arch" type="xml">
                <form string="Sugerencia de solución IA">
                    <field name="state" invisible="1"/>
                    <field name="incident_id" invisible="1"/>
                    <field name="needs_config" invisible="1"/>
                    <field name="has_enough_description" invisible="1"/>
                    
                    <!-- estado de confirmación -->
                    <div invisible="state != 'confirm'">
                        <div class="alert alert-info mb-3" role="alert">
                            <i class="fa fa-lightbulb-o" title="Sugerencia"/> <strong>Sugerencia de solución con IA</strong>
                            <p class="mb-0">La IA analizará el problema y sugerirá pasos para resolverlo</p>
                        </div>
                        
                        <group string="Problema a analizar">
                            <field name="incident_name" string="Título"/>
                            <field name="incident_description" string="Descripción" readonly="1"/>
                        </group>
                        
                        <!-- advertencia si no hay suficiente descripción -->
                        <div class="alert alert-warning" role="alert" invisible="has_enough_description">
                            <i class="fa fa-exclamation-triangle" title="Descripción insuficiente"/> <strong>Descripción insuficiente</strong>
                            <p class="mb-0">Añade más detalles a la descripción de la incidencia para obtener mejores sugerencias.</p>
                            <p class="mb-0 text-muted">Mínimo recomendado: 20 caracteres (actual: <field name="description_length" nolabel="1" class="d-inline"/>)</p>
                        </div>

                        <div class="alert alert-secondary mt-3" role="alert">
                            <i class="fa fa-bolt" title="Coste petición"/> 
                            <strong>Coste:</strong> 1 petición de <field name="remaining_requests" nolabel="1" class="d-inline"/> restantes hoy
                        </div>
                    </div>

                    <!-- estado de éxito -->
                    <div invisible="state != 'success'">
                        <div class="alert alert-success mb-3" role="alert">
                            <i class="fa fa-check-circle" title="Sugerencia lista"/> <strong>Sugerencia lista</strong>
                        </div>
                        
                        <group string="Solución sugerida por IA">
                            <field name="suggested_solution" nolabel="1" colspan="2" readonly="1"/>
                        </group>

                        <div class="text-muted mt-3 text-center">
                            <i class="fa fa-info-circle" title="Información"/> 
                            Peticiones restantes: <strong><field name="remaining_requests" nolabel="1" class="d-inline"/></strong>
                        </div>
                    </div>

                    <!-- estado de error -->
                    <div invisible="state != 'error'">
                        <div class="alert alert-danger" role="alert">
                            <i class="fa fa-exclamation-triangle" title="Error"/> <strong>Error</strong>
                            <p class="mb-0 mt-2"><field name="error_message" nolabel="1"/></p>
                        </div>
                        
                        <div class="text-center mt-3" invisible="not needs_config">
                            <p class="text-muted">Necesitas configurar la clave API de OpenRouter</p>
                        </div>
                    </div>

                    <footer>
                        <!-- botón analizar (solo si hay suficiente descripción) -->
                        <button name="action_confirm_analyze" 
                            string="Sugerir solución (1 petición)" 
                            type="object" 
                            class="btn-primary"
                            invisible="state != 'confirm' or not has_enough_description"/>
                        
                        <!-- botón deshabilitado si no hay descripción -->
                        <button string="Añade descripción primero" 
                            class="btn-secondary" 
                            disabled="1"
                            invisible="state != 'confirm' or has_enough_description"/>
                        
                        <!-- botón aplicar solución -->
                        <button name="action_apply_solution" 
                            string="Añadir a solución" 
                            type="object" 
                            class="btn-primary"
                            invisible="state != 'success'"/>
                        
                        <!-- botón ir a configuración -->
                        <button name="action_open_settings" 
                            string="Ir a configuración" 
                            type="object" 
                            class="btn-primary"
                            invisible="not needs_config"/>
                        
                        <button name="action_close" 
                            string="Cerrar" 
                            type="object" 
                            class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- acción -->
        <record id="pcr_suggest_solution_wizard_action" model="ir.actions.act_window">
            <field name="name">Sugerir solución (IA)</field>
            <field name="res_model">pcr_incident_manager.suggest.solution.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="binding_model_id" ref="model_pcr_incident_manager_incident"/>
            <field name="binding_view_types">form</field>
        </record>
    </data>
</odoo>
