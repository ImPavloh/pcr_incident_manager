<odoo>
    <data>
        <!-- para ver equipos e incidencias en la ficha de partner -->
        <record id="view_partner_form_inherit_equipment" model="ir.ui.view">
            <field name="name">res.partner.form.inherit.equipment</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page string="Equipos IT" name="equipment_page">
                        <group>
                            <group>
                                <field name="equipment_count" string="Total de equipos"/>
                                <button name="action_view_equipment" 
                                    type="object" 
                                    string="Ver equipos"
                                    class="btn-link"
                                    icon="fa-desktop"/>
                            </group>
                            <group>
                                <field name="incident_count" string="Total de incidencias"/>
                                <button name="action_view_incidents" 
                                    type="object" 
                                    string="Ver incidencias"
                                    class="btn-link"
                                    icon="fa-exclamation-triangle"
                                    invisible="incident_count == 0"/>
                            </group>
                        </group>
                        <field name="equipment_ids" nolabel="1">
                            <tree>
                                <field name="image"
                                    widget="image"
                                    class="oe_avatar"
                                    options="{'preview_image': 'image', 'size': [128, 128]}"
                                    />
                                <field name="code"/>
                                <field name="name"/>
                                <field name="category"/>
                                <field name="state" widget="badge"
                                    decoration-success="state == 'operative'"
                                    decoration-danger="state == 'broken'"
                                    decoration-warning="state == 'maintenance'"
                                />
                                <field name="incident_count"/>
                            </tree>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>

        <!-- para ver equipos e incidencias -->
        <record id="view_partner_form_inherit_smart_button" model="ir.ui.view">
            <field name="name">res.partner.form.inherit.smart.button</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="priority">99</field>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_view_equipment"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-desktop"
                        invisible="equipment_count == 0">
                        <field name="equipment_count" string="Equipos" widget="statinfo"/>
                    </button>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
