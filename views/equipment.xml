<odoo>
    <data>
        <!-- Vista tree equipos -->
        <record id="pcr_equipment_view_tree" model="ir.ui.view">
            <field name="name">pcr.equipment.tree</field>
            <field name="model">pcr_incident_manager.equipment</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="image" widget="image" class="oe_avatar" options="{'preview_image': 'image', 'size': [128, 128]}"/>
                    <field name="code"/>
                    <field name="name"/>
                    <field name="category"/>
                    <field name="partner_id"/>
                    <field name="serial_number" optional="hide"/>
                    <field name="purchase_date" optional="hide"/>
                    <field name="state"
                        widget="badge"
                        decoration-success="state == 'operative'"
                        decoration-danger="state == 'broken'"
                        decoration-warning="state == 'maintenance'"
                    />
                    <field name="incident_count" string="Incidencias"/>
                    <field name="open_incident_count" string="Abiertas" 
                        decoration-danger="open_incident_count > 0"/>
                </tree>
            </field>
        </record>

        <!-- Vista form equipos -->
        <record id="pcr_equipment_view_form" model="ir.ui.view">
            <field name="name">pcr.equipment.form</field>
            <field name="model">pcr_incident_manager.equipment</field>
            <field name="arch" type="xml">
                <form string="Equipo">
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="%(pcr_incident_action)d"
                                type="action"
                                class="oe_stat_button"
                                icon="fa-exclamation-triangle"
                                context="{'search_default_equipment_id': id}"
                                invisible="incident_count == 0">
                                <field name="incident_count" string="Incidencias" widget="statinfo"/>
                            </button>
                        </div>
                        <field name="image"
                            widget="image"
                            class="oe_avatar"
                            options="{'preview_image': 'image', 'size': [128, 128]}"
                        />
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Nombre del equipo"/>
                            </h1>
                        </div>
                        <group>
                            <group string="Identificación">
                                <field name="code"/>
                                <field name="serial_number"/>
                                <field name="category"/>
                            </group>
                            <group string="Información">
                                <field name="partner_id"/>
                                <field name="purchase_date"/>
                                <field name="state" widget="radio"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Descripción">
                                <field name="description" placeholder="Descripción del equipo..."/>
                            </page>
                            <page string="Incidencias" name="incidents_page">
                                <field name="incident_ids">
                                    <tree>
                                        <field name="reference"/>
                                        <field name="name"/>
                                        <field name="priority" widget="priority"/>
                                        <field name="state" widget="badge"
                                            decoration-info="state == 'open'"
                                            decoration-warning="state == 'in_progress'"
                                            decoration-success="state == 'resolved'"
                                            decoration-muted="state == 'closed'"
                                            decoration-danger="state == 'cancelled'"
                                        />
                                        <field name="technician_id"/>
                                        <field name="date_created"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Vista Kanban equipos -->
        <record id="pcr_equipment_view_kanban" model="ir.ui.view">
            <field name="name">pcr.equipment.kanban</field>
            <field name="model">pcr_incident_manager.equipment</field>
            <field name="arch" type="xml">
                <kanban>
                    <field name="id"/>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="category"/>
                    <field name="state"/>
                    <field name="image" widget="image" preview_image="image"/>
                    <field name="incident_count"/>
                    <field name="open_incident_count"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_global_click o_kanban_record_has_image_fill">
                                <div class="o_kanban_image_fill_left d-none d-md-block"
                                    t-attf-style="background-image: url('#{kanban_image('pcr_incident_manager.equipment', 'image', record.id.raw_value)}')">
                                </div>
                                <div class="oe_kanban_details">
                                    <div class="o_kanban_record_top">
                                        <div class="o_kanban_record_headings">
                                            <strong class="o_kanban_record_title">
                                                <field name="name"/>
                                            </strong>
                                        </div>
                                    </div>
                                    <div class="o_kanban_record_body">
                                        <div t-if="record.code.value">
                                            <span class="text-muted">Código:</span>
                                            <field name="code"/>
                                        </div>
                                        <div t-if="record.category.value">
                                            <span class="badge bg-secondary">
                                                <field name="category"/>
                                            </span>
                                        </div>
                                    </div>
                                    <div class="o_kanban_record_bottom">
                                        <div class="oe_kanban_bottom_left">
                                            <span t-if="record.state.raw_value == 'operative'" class="badge bg-success">Operativo</span>
                                            <span t-if="record.state.raw_value == 'broken'" class="badge bg-danger">Averiado</span>
                                            <span t-if="record.state.raw_value == 'maintenance'" class="badge bg-warning">Mantenimiento</span>
                                        </div>
                                        <div class="oe_kanban_bottom_right">
                                            <span t-if="record.open_incident_count.raw_value > 0" 
                                                class="badge bg-danger" 
                                                title="Incidencias abiertas">
                                                <i class="fa fa-exclamation-triangle" title="Incidencias abiertas"/> 
                                                <field name="open_incident_count"/>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Vista Search equipos -->
        <record id="pcr_equipment_view_search" model="ir.ui.view">
            <field name="name">pcr.equipment.search</field>
            <field name="model">pcr_incident_manager.equipment</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="serial_number"/>
                    <field name="category"/>
                    <field name="partner_id"/>
                    <filter string="Operativos" name="operative" domain="[('state', '=', 'operative')]"/>
                    <filter string="Averiados" name="broken" domain="[('state', '=', 'broken')]"/>
                    <filter string="En mantenimiento" name="maintenance" domain="[('state', '=', 'maintenance')]"/>
                    <separator/>
                    <filter string="Con incidencias abiertas" name="with_open_incidents" 
                        domain="[('open_incident_count', '>', 0)]"/>
                    <group expand="0" string="Agrupar por">
                        <filter string="Estado" name="group_state" context="{'group_by': 'state'}"/>
                        <filter string="Categoría" name="group_category" context="{'group_by': 'category'}"/>
                        <filter string="Propietario" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Acción equipos -->
        <record id="pcr_equipment_action" model="ir.actions.act_window">
            <field name="name">Equipos</field>
            <field name="res_model">pcr_incident_manager.equipment</field>
            <field name="view_mode">kanban,tree,form</field>
            <field name="search_view_id" ref="pcr_equipment_view_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Crea tu primer equipo
                </p>
                <p>
                    Registra los equipos y activos de tu organización para gestionar sus incidencias.
                </p>
            </field>
        </record>
    </data>
</odoo>
