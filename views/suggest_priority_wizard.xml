<odoo>
    <data>
        <!-- vista tree -->
        <record id="pcr_suggest_priority_wizard_tree" model="ir.ui.view">
            <field name="name">pcr.suggest.priority.wizard.tree</field>
            <field name="model">pcr_incident_manager.suggest.priority.wizard</field>
            <field name="arch" type="xml">
                <tree string="Sugerencias de prioridad">
                    <field name="incident_id"/>
                    <field name="suggested_priority"/>
                    <field name="create_date" string="Fecha"/>
                </tree>
            </field>
        </record>

        <!-- vista form -->
        <record id="pcr_suggest_priority_wizard_form" model="ir.ui.view">
            <field name="name">pcr.suggest.priority.wizard.form</field>
            <field name="model">pcr_incident_manager.suggest.priority.wizard</field>
            <field name="arch" type="xml">
                <form string="Sugerencia de prioridad IA">
                    <field name="state" invisible="1"/>
                    <field name="incident_id" invisible="1"/>
                    <field name="needs_config" invisible="1"/>
                    
                    <!-- estado de confirmación (antes de usar IA) -->
                    <div invisible="state != 'confirm'">
                        <div class="alert alert-info mb-3" role="alert">
                            <i class="fa fa-robot" title="Análisis IA"/> <strong>Análisis con IA</strong>
                            <p class="mb-0">¿Analizar esta incidencia para sugerir una prioridad?</p>
                        </div>
                        
                        <group string="Incidencia a analizar">
                            <field name="incident_name" string="Título"/>
                            <field name="current_priority" string="Prioridad actual" widget="priority"/>
                        </group>
                        
                        <group string="Calidad de datos para IA">
                            <div class="col-12">
                                <div class="d-flex align-items-center mb-2">
                                    <field name="has_description" invisible="1"/>
                                        <span invisible="not has_description" class="text-success">
                                        <i class="fa fa-check-circle" title="Tiene descripción"/> Tiene descripción
                                    </span>
                                    <span invisible="has_description" class="text-warning">
                                        <i class="fa fa-exclamation-circle" title="Sin descripción detallada"/> Sin descripción detallada
                                    </span>
                                </div>
                                <div class="d-flex align-items-center mb-2">
                                    <field name="has_equipment" invisible="1"/>
                                    <span invisible="not has_equipment" class="text-success">
                                        <i class="fa fa-check-circle" title="Tiene equipo asignado"/> Tiene equipo asignado
                                    </span>
                                    <span invisible="has_equipment" class="text-muted">
                                        <i class="fa fa-minus-circle" title="Sin equipo asignado"/> Sin equipo asignado
                                    </span>
                                </div>
                                <div class="d-flex align-items-center">
                                    <field name="has_types" invisible="1"/>
                                    <span invisible="not has_types" class="text-success">
                                        <i class="fa fa-check-circle" title="Tiene tipos asignados"/> Tiene tipos asignados
                                    </span>
                                    <span invisible="has_types" class="text-muted">
                                        <i class="fa fa-minus-circle" title="Sin tipos asignados"/> Sin tipos asignados
                                    </span>
                                </div>
                            </div>
                        </group>

                        <div class="alert alert-warning mt-3" role="alert">
                            <i class="fa fa-bolt" title="Coste petición"/> 
                            <strong>Coste:</strong> 1 petición de <field name="remaining_requests" nolabel="1" class="d-inline"/> restantes hoy
                        </div>
                    </div>

                    <!-- estado de éxito -->
                    <div invisible="state != 'success'">
                        <div class="alert alert-success mb-3" role="alert">
                            <i class="fa fa-check-circle" title="Análisis completado"/> <strong>Análisis completado</strong>
                        </div>
                        
                        <group>
                            <group string="Comparación de prioridades">
                                <field name="current_priority" widget="priority"/>
                                <field name="suggested_priority" widget="priority"/>
                            </group>
                            <group string="Análisis de IA">
                                <field name="reason" nolabel="1" colspan="2"/>
                            </group>
                        </group>
                        
                        <!-- advertencias (si las hay) -->
                        <field name="warnings" invisible="1"/>
                        <div class="alert alert-info" role="alert" invisible="not warnings">
                            <i class="fa fa-lightbulb-o" title="Sugerencia"/> <strong>Sugerencia:</strong>
                            <p><field name="warnings" nolabel="1"/></p>
                        </div>

                        <div class="text-muted mt-3 text-center">
                            <i class="fa fa-info-circle" title="Información"/> 
                            Peticiones restantes: <strong><field name="remaining_requests" nolabel="1" class="d-inline"/></strong>
                        </div>
                    </div>

                    <!-- estado de error -->
                    <div invisible="state != 'error'">
                        <div class="alert alert-danger" role="alert">
                            <i class="fa fa-exclamation-triangle" title="Error"/> <strong>Error</strong>
                            <p class="mb-0 mt-2"><field name="error_message" nolabel="1"/></p>
                        </div>
                        
                        <div class="text-center mt-3" invisible="not needs_config">
                            <p class="text-muted">Necesitas configurar la clave API de OpenRouter</p>
                        </div>
                        
                        <div class="alert alert-info mt-3" role="alert" invisible="needs_config">
                            <i class="fa fa-info-circle" title="Información"/> 
                            Peticiones restantes: <strong><field name="remaining_requests" nolabel="1" class="d-inline"/></strong>
                        </div>
                    </div>

                    <footer>
                        <!-- Botón confirmar (antes de llamar a IA) -->
                        <button name="action_confirm_analyze" 
                            string="Analizar con IA (1 petición)" 
                            type="object" 
                            class="btn-primary"
                            invisible="state != 'confirm'"/>
                        
                        <!-- Botón aplicar (después del análisis) -->
                        <button name="action_apply_priority" 
                            string="Aplicar sugerencia" 
                            type="object" 
                            class="btn-primary"
                            invisible="state != 'success'"/>
                        
                        <!-- Botón ir a configuración (si hay error) -->
                        <button name="action_open_settings" 
                            string="Ir a configuración" 
                            type="object" 
                            class="btn-primary"
                            invisible="not needs_config"/>
                        
                        <button name="action_close" 
                            string="Cancelar" 
                            type="object" 
                            class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- accion -->
        <record id="pcr_suggest_priority_wizard_action" model="ir.actions.act_window">
            <field name="name">Sugerir prioridad (IA)</field>
            <field name="res_model">pcr_incident_manager.suggest.priority.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="binding_model_id" ref="model_pcr_incident_manager_incident"/>
            <field name="binding_view_types">form</field>
        </record>
    </data>
</odoo>
