<odoo>
    <data>
        <!-- vista tree categorías de equipo -->
        <record id="pcr_equipment_category_view_tree" model="ir.ui.view">
            <field name="name">pcr.equipment.category.tree</field>
            <field name="model">pcr_incident_manager.equipment_category</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="complete_name"/>
                    <field name="is_it_equipment"/>
                    <field name="maintenance_frequency"/>
                </tree>
            </field>
        </record>

        <!-- vista form categorías de equipo -->
        <record id="pcr_equipment_category_view_form" model="ir.ui.view">
            <field name="name">pcr.equipment.category.form</field>
            <field name="model">pcr_incident_manager.equipment_category</field>
            <field name="arch" type="xml">
                <form string="Categoría de equipo">
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Nombre de la categoría"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="parent_id"/>
                                <field name="is_it_equipment"/>
                            </group>
                            <group>
                                <field name="maintenance_frequency"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Subcategorías">
                                <field name="child_id">
                                    <tree>
                                        <field name="name"/>
                                        <field name="is_it_equipment"/>
                                        <field name="maintenance_frequency"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Equipos">
                                <field name="equipment_ids">
                                    <tree>
                                        <field name="name"/>
                                        <field name="code"/>
                                        <field name="state"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- acción -->
        <record id="action_pcr_equipment_category" model="ir.actions.act_window">
            <field name="name">Categorías de equipo</field>
            <field name="res_model">pcr_incident_manager.equipment_category</field>
            <field name="view_mode">tree,form</field>
        </record>
    </data>
</odoo>
