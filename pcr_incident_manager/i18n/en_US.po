#. module: pcr_incident_manager
#: model:res.groups,comment:pcr_incident_manager.group_incident_manager
msgid ""
"\n"
"                Acceso completo a todas las incidencias, equipos, técnicos y configuración.\n"
"                Puede ver estadísticas y reportes globales.\n"
"            "
msgstr ""
"\n"
"                Full access to all incidents, equipment, technicians and settings.\n"
"                Can view global statistics and reports.\n"
"            "

#. module: pcr_incident_manager
#: model:res.groups,comment:pcr_incident_manager.group_incident_technician
msgid ""
"\n"
"                Puede ver y gestionar solo las incidencias que tiene asignadas.\n"
"                Acceso limitado a equipos y tipos de incidencia.\n"
"            "
msgstr ""
"\n"
"                Can view and manage only the incidents assigned to them.\n"
"                Limited access to equipment and incident types.\n"
"            "

