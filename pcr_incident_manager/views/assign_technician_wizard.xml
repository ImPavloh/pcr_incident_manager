<odoo>
    <data>
        <!-- vista form -->
        <record id="pcr_assign_technician_wizard_form" model="ir.ui.view">
            <field name="name">pcr.assign.technician.wizard.form</field>
            <field name="model">pcr_incident_manager.assign.technician.wizard</field>
            <field name="arch" type="xml">
                <form string="Asignar técnico">
                    <group>
                        <field name="technician_id" options="{'no_create': True}"/>
                        <field name="incident_ids" nolabel="1">
                            <tree>
                                <field name="reference"/>
                                <field name="name"/>
                                <field name="priority" widget="priority"/>
                                <field name="state" widget="badge"/>
                            </tree>
                        </field>
                    </group>
                    <footer>
                        <button name="action_assign" string="Asignar" type="object" class="btn-primary"/>
                        <button string="Cancelar" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- vista tree -->
        <record id="pcr_assign_technician_wizard_tree" model="ir.ui.view">
            <field name="name">pcr.assign.technician.wizard.tree</field>
            <field name="model">pcr_incident_manager.assign.technician.wizard</field>
            <field name="arch" type="xml">
                <tree string="Asignaciones de técnico">
                    <field name="technician_id"/>
                    <field name="create_date" string="Fecha"/>
                </tree>
            </field>
        </record>

        <!-- accion -->
        <record id="pcr_assign_technician_wizard_action" model="ir.actions.act_window">
            <field name="name">Asignar técnico</field>
            <field name="res_model">pcr_incident_manager.assign.technician.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="binding_model_id" ref="model_pcr_incident_manager_incident"/>
            <field name="binding_view_types">list</field>
        </record>
    </data>
</odoo>
