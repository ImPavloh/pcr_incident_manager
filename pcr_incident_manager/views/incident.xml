<odoo>
    <data>
        <!-- Vista tree incidencias -->
        <record id="pcr_incident_view_tree" model="ir.ui.view">
            <field name="name">pcr.incident.tree</field>
            <field name="model">pcr_incident_manager.incident</field>
            <field name="arch" type="xml">
                <tree decoration-danger="days_open > 7 and state in ['open', 'in_progress']">
                    <field name="reference"/>
                    <field name="name"/>
                    <field name="equipment_id"/>
                    <field name="technician_id"/>
                    <field name="priority" widget="priority" readonly="1"/>
                    <field name="state"
                        widget="badge"
                        decoration-info="state == 'open'"
                        decoration-warning="state == 'in_progress'"
                        decoration-success="state == 'resolved'"
                        decoration-muted="state == 'closed'"
                        decoration-danger="state == 'cancelled'"
                    />
                    <field name="date_created"/>
                    <field name="days_open" string="Días abierta"/>
                </tree>
            </field>
        </record>

        <!-- Vista form incidencias -->
        <record id="pcr_incident_view_form" model="ir.ui.view">
            <field name="name">pcr.incident.form</field>
            <field name="model">pcr_incident_manager.incident</field>
            <field name="arch" type="xml">
                <form string="Incidencia">
                    <header>
                        <button name="action_start"
                            type="object"
                            string="Iniciar" 
                            class="btn-primary" 
                            invisible="state != 'open'"/>
                        <button name="action_resolve"
                            type="object"
                            string="Resolver" 
                            class="btn-primary" 
                            invisible="state != 'in_progress'"/>
                        <button name="action_close"
                            type="object"
                            string="Cerrar" 
                            class="btn-secondary" 
                            invisible="state != 'resolved'"/>
                        <button name="action_reopen"
                            type="object"
                            string="Reabrir" 
                            class="btn-secondary" 
                            invisible="state not in ['resolved', 'closed']"/>
                        <button name="action_cancel"
                            type="object"
                            string="Cancelar" 
                            class="btn-danger" 
                            invisible="state != 'open'"
                            confirm="¿Seguro que deseas cancelar esta incidencia? Se descartará sin resolver."/>
                        <field name="state"
                            widget="statusbar"
                            statusbar_visible="open,in_progress,resolved,closed"
                            />
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <div class="d-flex justify-content-between">
                                <div>
                                    <span class="o_form_label"><field name="reference"/></span>
                                    <h1>
                                        <field name="name" placeholder="Título de la incidencia" />
                                    </h1>
                                </div>
                                <div class="text-end" style="min-width: 80px;" invisible="not id">
                                    <field name="qr_code" widget="image" 
                                        options="{'size': [80, 80]}"
                                        title="Escanea para abrir"/>
                                </div>
                            </div>
                        </div>
                        <group>
                            <group string="Información">
                                <field name="equipment_id"/>
                                <field name="technician_id"/>
                                <field name="priority"/>
                                <button name="action_suggest_priority" 
                                    type="object" 
                                    string="Sugerir prioridad" 
                                    class="btn-link"
                                    title="Usa 1 petición de IA"
                                    invisible="state in ['resolved', 'closed', 'cancelled']"/>
                            </group>
                            <group string="Fechas">
                                <field name="date_created"/>
                                <field name="date_closed"/>
                                <field name="days_open" readonly="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Descripción">
                                <field name="description" placeholder="Describe la incidencia..." />
                            </page>
                            <page string="Solución" invisible="state in ['open', 'cancelled']">
                                    <p class="text-muted" invisible="state in ['resolved', 'closed']">
                                    <i class="fa fa-info-circle" title="Información"/> Describe la solución antes de marcar como resuelta
                                </p>
                                <field name="solution" placeholder="Describe como se resolvió..."/>
                                <button name="action_suggest_solution" 
                                    type="object" 
                                    string="Sugerir solución (IA)" 
                                    class="btn-link"
                                    title="Usa 1 petición de IA"
                                    invisible="state in ['resolved', 'closed']"/>
                            </page>
                            <page string="Clasificación">
                                <field name="type_ids" widget="many2many_tags"/>
                            </page>
                        </notebook>
                    </sheet>

                    <!-- Chatter -->
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="activity_ids" widget="mail_activity"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>
            </field>
        </record>


        <!-- Vista Kanban incidencias -->
        <record id="pcr_incident_view_kanban" model="ir.ui.view">
            <field name="name">pcr.incident.kanban</field>
            <field name="model">pcr_incident_manager.incident</field>
            <field name="arch" type="xml">
                <kanban default_group_by="state" class="o_kanban_small_column">
                    <field name="id"/>
                    <field name="name"/>
                    <field name="reference"/>
                    <field name="equipment_id"/>
                    <field name="technician_id"/>
                    <field name="priority"/>
                    <field name="state"/>
                    <field name="days_open"/>
                    <field name="date_created"/>
                    <progressbar field="priority" colors='{"0": "muted", "1": "info", "2": "warning", "3": "danger"}'/>
                    <templates>
                        <t t-name="kanban-box">
                            <div t-attf-class="oe_kanban_global_click #{record.priority.raw_value == '3' ? 'border-danger border-2' : ''}">
                                <div class="oe_kanban_content">
                                    <div class="o_kanban_record_top mb-1">
                                        <div class="o_kanban_record_headings">
                                            <span class="badge bg-secondary me-1"><field name="reference"/></span>
                                            <field name="priority" widget="priority"/>
                                        </div>
                                    </div>
                                    <strong class="o_kanban_record_title"><field name="name"/></strong>
                                    <div class="text-muted mt-1">
                                        <i class="fa fa-desktop" title="Equipo"/> <field name="equipment_id"/>
                                    </div>
                                    <div class="o_kanban_record_bottom mt-2">
                                        <div class="oe_kanban_bottom_left text-muted small">
                                            <t t-if="record.days_open.raw_value > 0">
                                                <i class="fa fa-clock-o" title="Tiempo abierto"/> <field name="days_open"/> días
                                            </t>
                                            <t t-else="">
                                                <i class="fa fa-calendar" title="Creada hoy"/> Hoy
                                            </t>
                                        </div>
                                        <div class="oe_kanban_bottom_right">
                                            <img t-if="record.technician_id.raw_value" 
                                                 t-att-src="kanban_image('pcr_incident_manager.technician', 'image', record.technician_id.raw_value)"
                                                 class="rounded-circle" style="width: 24px; height: 24px;"
                                                 t-att-title="record.technician_id.value"
                                                 alt="Técnico"/>
                                            <span t-if="!record.technician_id.raw_value" class="text-muted small">
                                                <i class="fa fa-user-o" title="Sin asignar"/>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Vista search/filtros -->
        <record id="pcr_incident_view_search" model="ir.ui.view">
            <field name="name">pcr.incident.search</field>
            <field name="model">pcr_incident_manager.incident</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="reference"/>
                    <field name="equipment_id"/>
                    <field name="technician_id"/>
                    <field name="type_ids"/>
                    <filter string="Sin asignar" name="unassigned" domain="[('technician_id', '=', False)]"/>
                    <filter string="Abiertas" name="open" domain="[('state', '=', 'open')]"/>
                    <filter string="En proceso" name="in_progress" domain="[('state', '=', 'in_progress')]"/>
                    <filter string="Resueltas" name="resolved" domain="[('state', '=', 'resolved')]"/>
                    <filter string="Cerradas" name="closed" domain="[('state', '=', 'closed')]"/>
                    <filter string="Canceladas" name="cancelled" domain="[('state', '=', 'cancelled')]"/>
                    <separator/>
                    <filter string="Prioridad urgente" name="urgent" domain="[('priority', '=', '3')]"/>
                    <filter string="Prioridad alta" name="high_priority" domain="[('priority', '=', '2')]"/>
                    <separator/>
                    <filter string="Antiguas (> 7 días)" name="old" domain="[('days_open', '>', 7)]"/>
                    <filter string="Muy antiguas (> 30 días)" name="very_old" domain="[('days_open', '>', 30)]"/>
                    <separator/>
                    <filter string="Creadas hoy" name="today" domain="[('date_created', '>=', (context_today()).strftime('%Y-%m-%d'))]"/>
                    <filter string="Creadas esta semana" name="this_week" domain="[('date_created', '>=', (context_today() - datetime.timedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                    <filter string="Creadas este mes" name="this_month" domain="[('date_created', '>=', (context_today()).strftime('%Y-%m-01'))]"/>
                    <group expand="0" string="Agrupar por">
                        <filter string="Estado" name="group_state" context="{'group_by': 'state'}"/>
                        <filter string="Prioridad" name="group_priority" context="{'group_by': 'priority'}"/>
                        <filter string="Técnico" name="group_technician" context="{'group_by': 'technician_id'}"/>
                        <filter string="Equipo" name="group_equipment" context="{'group_by': 'equipment_id'}"/>
                        <filter string="Fecha de creación" name="group_date_created" context="{'group_by': 'date_created:month'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- vista calendario -->
        <record id="pcr_incident_view_calendar" model="ir.ui.view">
            <field name="name">pcr.incident.calendar</field>
            <field name="model">pcr_incident_manager.incident</field>
            <field name="arch" type="xml">
                <calendar string="Calendario de incidencias" 
                    date_start="date_created" 
                    date_stop="date_closed"
                    color="technician_id"
                    mode="month"
                    quick_create="0"
                    event_open_popup="1">
                    <field name="name"/>
                    <field name="equipment_id"/>
                    <field name="technician_id"/>
                    <field name="priority"/>
                    <field name="state"/>
                </calendar>
            </field>
        </record>

        <!-- vista de gráficos -->
        <record id="pcr_incident_view_graph" model="ir.ui.view">
            <field name="name">pcr.incident.graph</field>
            <field name="model">pcr_incident_manager.incident</field>
            <field name="arch" type="xml">
                <graph string="Análisis de incidencias" type="bar" sample="1">
                    <field name="state" type="row"/>
                    <field name="priority" type="col"/>
                    <field name="id" type="measure"/>
                </graph>
            </field>
        </record>

        <!-- vista pivot -->
        <record id="pcr_incident_view_pivot" model="ir.ui.view">
            <field name="name">pcr.incident.pivot</field>
            <field name="model">pcr_incident_manager.incident</field>
            <field name="arch" type="xml">
                <pivot string="Tabla dinámica de incidencias" sample="1">
                    <field name="state" type="row"/>
                    <field name="technician_id" type="row"/>
                    <field name="priority" type="col"/>
                    <field name="days_open" type="measure"/>
                </pivot>
            </field>
        </record>

        <!-- vista actividad -->
        <record id="pcr_incident_view_activity" model="ir.ui.view">
            <field name="name">pcr.incident.activity</field>
            <field name="model">pcr_incident_manager.incident</field>
            <field name="arch" type="xml">
                <activity string="Actividades de incidencias">
                    <field name="reference"/>
                    <field name="name"/>
                    <field name="technician_id"/>
                    <field name="priority"/>
                    <field name="state"/>
                    <templates>
                        <div t-name="activity-box">
                            <div>
                                <field name="reference" class="o_text_bold"/>
                                <field name="name" muted="1" display="full"/>
                            </div>
                        </div>
                    </templates>
                </activity>
            </field>
        </record>

        <!-- accion -->
        <record id="pcr_incident_action" model="ir.actions.act_window">
            <field name="name">Incidencias</field>
            <field name="res_model">pcr_incident_manager.incident</field>
            <field name="view_mode">kanban,tree,form,calendar,graph,pivot,activity</field>
            <field name="search_view_id" ref="pcr_incident_view_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Registra tu incidencia
                </p>
                <p>
                    Empieza a gestionar las incidencias de tu organización
                </p>
            </field>
        </record>
    </data>
</odoo>
